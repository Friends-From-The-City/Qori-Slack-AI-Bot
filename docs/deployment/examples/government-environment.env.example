# ============================================
# QORI — Government Deployment Environment
# ============================================
# Sample deployment profile for a government or public-sector organization.
# All values are placeholders. Replace with your organization's actual values.
#
# No Friends Innovation Lab-specific identifiers appear in this file.
# The deploying organization controls all configuration.
#
# DO NOT commit real credentials to version control.

# ============================================
# Application
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Database (PostgreSQL 14+)
# ============================================
# Your organization's PostgreSQL instance.
# TLS is recommended for production — configure at the infrastructure level.
DB_HOST=your-postgres-host.agency.gov
DB_PORT=5432
DB_NAME=qori_production
DB_USER=qori_app
DB_PASSWORD=<your-database-password>
DB_DIALECT=postgres

# ============================================
# Redis (optional)
# ============================================
# Redis is not required. Qori operates fully without it.
# Only needed if re-enabling the RAG pipeline in the future.
# REDIS_HOST=your-redis-host.agency.gov
# REDIS_PORT=6379
# REDIS_URI=redis://your-redis-host.agency.gov:6379

# ============================================
# Slack
# ============================================
# Your organization's Slack app credentials.
# Create a Slack app in your workspace: https://api.slack.com/apps
# Enable Socket Mode and create an app-level token with connections:write scope.
#
# CRITICAL: Each environment (dev, staging, prod) must have its own Slack app.
# Never share credentials between environments.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Optional: Slack channel for operational alerts (create a channel, copy its ID)
# QORI_ALERTS_CHANNEL_ID=C0000000000

# Optional: Research team notifications channel
# RESEARCH_TEAM_CHANNEL_ID=C0000000000

# ============================================
# GitHub
# ============================================
# Your organization's GitHub configuration.
# Token needs 'repo' scope. Can be a PAT or GitHub App installation token.
GITHUB_TOKEN=ghp_your-github-token
GITHUB_OWNER=your-agency-org
GITHUB_REPO=research-studies
# Optional: separate repo for YAML templates and config.
# If not set, uses GITHUB_REPO for both content and config.
# GITHUB_CONFIG_REPO=research-config

# ============================================
# AI / Model Provider
# ============================================
# Anthropic API key. If your agency uses an approved AI gateway or proxy,
# configure the proxy at the infrastructure level (e.g., HTTPS_PROXY).
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Optional model overrides (defaults are current Claude model versions)
# ANTHROPIC_MODEL_NAME=claude-sonnet-4-6
# ANTHROPIC_TEMPERATURE=0.4
# ANTHROPIC_MAX_TOKENS=8192
# EXTRACTION_MODEL_NAME=claude-haiku-4-5-20251001

# ============================================
# Observability (optional)
# ============================================
# Sentry-compatible error reporting endpoint.
# Qori operates correctly without this — errors go to stdout.
# PII is scrubbed before any data leaves the application.
# SENTRY_DSN=https://your-key@your-sentry.agency.gov/project-id

# Release identifier for observability tagging.
# Set to the deployed commit SHA, semantic version, or deployment ID.
# QORI_RELEASE_ID=v1.0.0

# ============================================
# Team Identity
# ============================================
# Team slug for discovery workspace scoping in the content repo.
# Discovery artifacts are stored at {team}/_discovery/.
QORI_TEAM_SLUG=your-research-team

# ============================================
# Security
# ============================================
# JWT signing key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET_KEY=<your-random-secret-key>

# CORS origin (set to your web frontend URL if applicable)
# CORS_ALLOWED_ORIGIN=https://qori.agency.gov

# ============================================
# SMTP (optional)
# ============================================
# Only needed if using email features.
# SMTP_HOST=smtp.agency.gov
# SMTP_PORT=587
# SMTP_USER=qori@agency.gov
# SMTP_PASSWORD=<your-smtp-password>

# ============================================
# Future: Identity Provider (not yet implemented)
# ============================================
# These settings are reserved for PLAT-2/PLAT-3 authentication integration.
# OIDC_ISSUER=https://login.agency.gov
# OIDC_CLIENT_ID=qori-client-id
# OIDC_CLIENT_SECRET=<your-oidc-secret>
