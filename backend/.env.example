# ============================================
# QORI SLACK AI BOT - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
#
# ============================================
# ENVIRONMENT SAFETY GUARD
# ============================================
# Before running, verify you're using the correct environment:
#
# PRODUCTION indicators (STOP if you see these in local dev):
#   - SLACK_APP_TOKEN contains A08U0FLM4AG (the PROD app ID)
#   - DB_HOST contains: railway.app or .railway.internal
#   - NODE_ENV=production
#
# DEVELOPMENT indicators (correct for local/dev work):
#   - SLACK_APP_TOKEN contains the DEV app ID (NOT A08U0FLM4AG)
#   - DB_HOST: localhost OR dev.railway.app
#   - NODE_ENV=development
#
# If you're doing local development and see prod indicators, STOP.
# You're about to run against production. Check your .env file.
#
# INCIDENT 2026-07-28: Cross-environment token sharing caused a 3-day
# prod outage. The prod app-level token must ONLY exist in Railway prod.
# Local dev and Railway dev use the Qori-dev app's own token.

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# For local development:
DB_HOST=localhost
# For Docker:
# DB_HOST=postgres

DB_PORT=5432
DB_NAME=qori_dev
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres

# ============================================
# Redis Configuration
# ============================================
# For local development:
REDIS_HOST=localhost
# For Docker:
# REDIS_HOST=redis

REDIS_PORT=6379
REDIS_URI=redis://localhost:6379
# For Docker:
# REDIS_URI=redis://redis:6379

# ============================================
# Slack Configuration
# ============================================
# Get these from: https://api.slack.com/apps
# 1. Create a Slack app
# 2. OAuth & Permissions → Install to workspace → Copy Bot Token
# 3. Basic Information → Copy Signing Secret
# 4. App-Level Tokens → Create token with connections:write scope

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# ============================================
# GitHub Configuration
# ============================================
# Get token from: GitHub → Settings → Developer settings → Personal access tokens
# Required scopes: repo, workflow

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional: separate repo for config (YAML templates, study templates).
# If not set, falls back to GITHUB_REPO (single-repo mode).
# Useful when studies are written to one repo and config lives in another.
GITHUB_CONFIG_REPO=

# ============================================
# AI/LLM Configuration
# ============================================
# Anthropic (Claude) - Required
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional Anthropic settings (defaults shown)
ANTHROPIC_MODEL_NAME=claude-sonnet-4-6
ANTHROPIC_TEMPERATURE=0.4
ANTHROPIC_MAX_TOKENS=3000

# ============================================
# RAG Pipeline (Optional — disabled for alpha)
# ============================================
# These are only needed if you want to enable the RAG-based study search
# features (/civicmind ask-study, /ask-study, /run-template).
# If all three are set, the RAG pipeline initializes automatically on boot.
# If any are missing, the server boots fine and RAG commands return a
# "not available yet" message.

# OpenAI - used for gpt-4o-mini + embeddings in the RAG pipeline
# Get from: https://platform.openai.com/
# OPENAI_API_KEY=sk-your-openai-key-here

# Supabase - vector store for document search
# Get from: https://supabase.com/ → Your project → Settings → API
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================
# Security & Authentication
# ============================================
# Generate a secure random string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=your-random-secret-key-here

# ============================================
# Monitoring & Error Tracking
# ============================================
# Get DSN from: https://sentry.io/
# Only required for production (disabled in development mode)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Release identifier for observability tagging.
# Set to a commit SHA, semantic version, or deployment identifier.
# Falls back to RAILWAY_GIT_COMMIT_SHA for Railway deployments.
# QORI_RELEASE_ID=

# Slack channel ID for error alerts (e.g., #qori-alerts)
# Create a channel, right-click > Copy link, extract the channel ID (C...)
# If not set, errors are still captured to Sentry but not posted to Slack
QORI_ALERTS_CHANNEL_ID=C1234567890

# ============================================
# Email/SMTP Configuration (Optional)
# ============================================
# Only required if using email features
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGIN=http://localhost:8000

# ============================================
# Research Team Channel (Optional)
# ============================================
# Slack channel ID for research team notifications
RESEARCH_TEAM_CHANNEL_ID=C1234567890

# ============================================
# Team Identity
# ============================================
# Team slug for discovery workspace scoping. Discovery artifacts are stored
# at {team}/_discovery/ in the content repo. Default: friends-lab
QORI_TEAM_SLUG=friends-lab
